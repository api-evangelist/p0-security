  "info": {
    "_postman_id": "f8ac0284-b689-4951-9a3c-a50c182b6997",
    "name": "P0 Just-in-Time Access Command Permission Requests API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "P0 Security's Just-In-Time (JIT) access API surface, consolidated from P0's published Command API and Permission Request API. These endpoints let external systems, bots, CI/CD pipelines, and security workflows programmatically submit access commands and approve, deny, or revoke permission requests within a P0 organization. All endpoints are protected with bearer (JWT) tokens.\n\nContact Support:\n Name: P0 Security",
      "type": "text/plain"
    }
  }
